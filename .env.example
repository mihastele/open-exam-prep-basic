# =============================================================================
# openExamPrep configuration. Copy this file to `.env` and edit.
#
# Every value shown is already the built-in default, so an unedited copy is a
# working config. The database, tracing and speech are all OPTIONAL — with none
# of them set the app still boots, answers, and stores material.
#
# README -> "Environment variables, and why each one matters" explains what each
# of these buys you.
# =============================================================================


# =============================================================================
# MODEL PROVIDER — the top-level override
# =============================================================================
# Leave this unset and the app chooses for you: the **Vercel AI Gateway** when it
# is deployed on a host like Vercel, local Ollama otherwise. Set it to force one:
#
#   MODEL_PROVIDER=hosted   -> Vercel AI Gateway, or any OpenAI-compatible API
#   MODEL_PROVIDER=ollama   -> a local Ollama server
#
# Whichever it resolves to is used by *every* feature — tutor, quizzes, mock
# exams, study plans, podcasts and embeddings. There is only one LLM client, so
# the tutor cannot end up on a different gateway from the rest.
#
# Why it defaults this way: on a hosted platform a local Ollama cannot exist, so
# defaulting to it made every request fail with nothing to explain why.
# MODEL_PROVIDER=hosted


# =============================================================================
# VERCEL AI GATEWAY — the default when hosted
# =============================================================================
# One base URL and one key serve BOTH chat and embeddings, so the default setup
# needs no separate EMBED_* block below.
#
# Get a key (free tier: $5/month of credits on a subset of models, zero markup):
#   https://vercel.com/d?to=%2F%5Bteam%5D%2F%7E%2Fai-gateway%2Fapi-keys
#
# On Vercel you can leave HOSTED_API_KEY empty. It falls back to
# AI_GATEWAY_API_KEY, and then to VERCEL_OIDC_TOKEN, which Vercel injects into
# every deployment — so a project can call the gateway without storing a secret.
#
# Model IDs are `creator/model`. `GET https://ai-gateway.vercel.sh/v1/models`
# needs no auth and returns the live catalogue, so check there rather than
# trusting a list in a README.
#
# Anything else OpenAI-compatible (OpenRouter, Together, vLLM, LM Studio) works
# by overriding these four.
HOSTED_BASE_URL=https://ai-gateway.vercel.sh/v1
HOSTED_API_KEY=
HOSTED_MODEL=alibaba/qwen3.7-flash
HOSTED_EMBED_MODEL=openai/text-embedding-3-small


# =============================================================================
# LOCAL OLLAMA — the offline alternative (no key, no account)
# =============================================================================
# Used when MODEL_PROVIDER=ollama, or when nothing is set and you are not on a
# hosted platform. Useful because it costs nothing and needs no network.
#
# Note: Ollama Cloud serves chat models only — it has no embedding models at all,
# so a *cloud* Ollama needs the EMBED_* block below to keep retrieval smart.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# =============================================================================
# EMBEDDINGS — optional dedicated endpoint
# =============================================================================
# Leave empty to reuse the chat provider. The default AI Gateway setup needs
# nothing here, because the gateway serves embeddings too.
#
# Set these when your chat provider cannot produce vectors: Ollama Cloud (no
# embedding models exist), or a self-hosted vLLM serving a chat model only.
# Without working embeddings the app still answers, but retrieval degrades to
# keyword search and the UI says so under the answer.
#
# Why it matters: embeddings are what make "answer from *my* notes" work. Keyword
# search finds the literal words; embeddings find the passage that means the
# same thing.
# EMBED_BASE_URL=https://api.openai.com/v1
# EMBED_API_KEY=sk-...
# EMBED_MODEL_NAME=text-embedding-3-small
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL_NAME=
# Width of the vector column. Empty = inferred from the embed model name
# (nomic-embed-text 768, text-embedding-3-small 1536, text-embedding-3-large
# 3072), which keeps the model and the column from drifting apart. Set it only
# for a model that is not in that table.
#
# Changing the embed model on a database that already has chunks is NOT a config
# change: stored vectors cannot be converted, so the old rows must be dropped and
# re-ingested.
#
# Leave this commented rather than blank — a numeric variable set to "" used to
# crash the app at import time on hosts that store it as an empty string. (Blank
# is tolerated now, but not setting it at all is clearer.)
# EMBED_DIM=1536

# =============================================================================
# OBSERVABILITY (optional — no keys means tracing is simply off)
# =============================================================================
# Langfuse records every prompt, the retrieved chunks, latency and cost. Skip it
# and requests behave identically and nothing is sent anywhere; /api/health
# reports tracing as off, and tells "off" apart from "configured but broken".
#
# Why it matters if you run this for real: it is the only way to see what the
# model was actually told — which prompt, which sources — when an answer looks
# wrong. Cloud or self-hosted.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# =============================================================================
# DATABASE (optional)
# =============================================================================
# Leave this commented out to run with no database at all: SQLite on disk
# locally, and in the temp directory on a serverless host.
#
# A configured database that cannot be reached is IGNORED, not fatal — the app
# falls back and says so. /api/health reports `datastore.fallback: true` with the
# reason and the UI shows a banner, because silently losing material is worse
# than admitting you are.
#
# Postgres is recommended for anything real, and there is a permanent free tier:
#   Neon     - 0.5 GB, 100 CU-hours/month, scale-to-zero, no inactivity pause
#   Supabase - 500 MB, but free projects pause after ~1 week idle
# Both ship pgvector. Paste the URL exactly as the provider gives it (a plain
# postgresql:// is fine — the driver is rewritten for you) and prefer a pooled
# host, because every serverless invocation opens its own connection.
#
# Why it matters: on serverless the SQLite fallback resets on each cold start, so
# uploaded material disappears. This is the difference between a demo and a tool.
# DATABASE_URL=postgresql+psycopg://oep:oep@localhost:5432/oep

# =============================================================================
# SPEECH (optional — the browser's own Web Speech API is the default)
# =============================================================================
# `none` uses the browser: free, no keys, and no audio leaves the device. Set a
# provider only if you need consistent voices across browsers, or server-side
# transcription of an uploaded recording.
STT_PROVIDER=none
TTS_PROVIDER=none


# =============================================================================
# CORS
# =============================================================================
# Only needed for the two-project deploy shape, where the frontend sits on a
# different origin from the API. In the single-project (Services) shape the app
# is same-origin and there is nothing to allow.
FRONTEND_URL=http://localhost:3000


# =============================================================================
# UPLOADS
# =============================================================================
# Where the raw uploaded file is kept, as a convenience copy. Empty = "uploads"
# locally and "/tmp/uploads" on serverless, where the rest of the filesystem is
# read-only. Empty is almost always what you want.
#
# Why it rarely matters: the parsed text and its chunks live in the database, so
# losing the original file does not lose your material.
UPLOAD_DIR=
# Rejection threshold for uploads. Empty = auto: 50 MB locally, 4 MB on
# serverless (Vercel rejects request bodies over 4.5 MB before your code runs).
# Lower it if you want a friendly error earlier than the platform's own.
# Leave commented rather than blank — see the EMBED_DIM note above.
# MAX_UPLOAD_MB=50


# =============================================================================
# PODCAST
# =============================================================================
# Target length of one planned section, the ceiling on sections per episode, and
# how many sections may be written at once.
#
# Why they matter: an episode is planned first and then written section by
# section, so these decide how the length target is divided up. PODCAST_WORKERS
# is the concurrency — keep it modest, because each worker makes its own provider
# call and its own database connection, and every extra one eats into the time
# budget of a single serverless request.
PODCAST_SECTION_MINUTES=4
PODCAST_MAX_SECTIONS=16
PODCAST_WORKERS=4
