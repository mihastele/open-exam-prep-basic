# --- Model provider switch: "ollama" (local, default) or "hosted" (any OpenAI-compatible API) ---
MODEL_PROVIDER=ollama

# Local open-weights runtime
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Hosted endpoint: Vercel AI Gateway (default) ----------------------------
# One base URL and one key serve both chat and embeddings. Create a key at
# https://vercel.com/d?to=%2F%5Bteam%5D%2F%7E%2Fai-gateway%2Fapi-keys
# On Vercel you can leave HOSTED_API_KEY empty: AI_GATEWAY_API_KEY and the
# deployment's VERCEL_OIDC_TOKEN are picked up automatically.
# Any other OpenAI-compatible provider works — override these four.
HOSTED_BASE_URL=https://ai-gateway.vercel.sh/v1
HOSTED_API_KEY=
HOSTED_MODEL=alibaba/qwen3.7-flash
HOSTED_EMBED_MODEL=openai/text-embedding-3-small

# --- Embeddings, optional dedicated endpoint ---------------------------------
# Leave empty to reuse the chat provider — the default AI Gateway setup needs
# nothing here, because the gateway serves embeddings too. Set these when your
# chat provider has no embedding models (notably Ollama Cloud).
# EMBED_BASE_URL=https://api.openai.com/v1
# EMBED_API_KEY=sk-...
# EMBED_MODEL_NAME=text-embedding-3-small
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL_NAME=
# Empty = inferred from the embed model — nomic-embed-text 768,
# text-embedding-3-small 1536, text-embedding-3-large 3072. It sizes the pgvector
# column, so changing it on a database that already has chunks needs a re-ingest.
# Leave it commented rather than blank; a numeric var set to "" is an import-time
# crash on hosts that store it as an empty string. (Blank is tolerated now, but
# not setting it at all is clearer.)
# EMBED_DIM=1536

# --- Observability (OPTIONAL; empty = tracing disabled) ----------------------
# No account needed. With no keys every request behaves identically and nothing is
# sent anywhere — /api/health reports tracing as off. Cloud or self-hosted.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Database (optional) ----------------------------------------------------
# Leave this commented out to run with no database at all: SQLite on disk locally,
# and in the temp dir on a serverless host (where it is ephemeral, and /api/health
# plus the status widget say so).
#
# Postgres is recommended for anything real, and there is a permanent free tier:
#   Neon     - 0.5 GB, 100 CU-hours/month, scale-to-zero, no inactivity pause
#   Supabase - 500 MB, but free projects pause after ~1 week idle
# Both ship pgvector. Paste the URL as the provider gives it (plain postgresql://
# is fine) and prefer a pooled host: each serverless invocation connects.
# DATABASE_URL=postgresql+psycopg://oep:oep@localhost:5432/oep

# --- Speech (optional; browser Web Speech is the default, no keys needed) ---
STT_PROVIDER=none
TTS_PROVIDER=none

# --- CORS ---
FRONTEND_URL=http://localhost:3000

# --- Uploads ----------------------------------------------------------------
# Empty = "uploads" locally and "/tmp/uploads" on serverless hosts, where the
# rest of the filesystem is read-only. Empty is almost always what you want.
UPLOAD_DIR=
# Empty = auto: 50 MB locally, 4 MB on serverless (Vercel rejects bodies > 4.5 MB).
# Leave commented rather than blank — see the EMBED_DIM note above.
# MAX_UPLOAD_MB=50

# --- Podcast ----------------------------------------------------------------
# How long one planned section should be, the ceiling on sections per episode,
# and how many sections may be written concurrently.
PODCAST_SECTION_MINUTES=4
PODCAST_MAX_SECTIONS=16
PODCAST_WORKERS=4
