# --- Model provider switch: "ollama" (local, default) or "hosted" (any OpenAI-compatible API) ---
MODEL_PROVIDER=ollama

# Local open-weights runtime
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Hosted open-weights endpoint (OpenRouter, Together, HuggingFace router, vLLM, ...)
HOSTED_BASE_URL=https://openrouter.ai/api/v1
HOSTED_API_KEY=
HOSTED_MODEL=qwen/qwen-2.5-72b-instruct
HOSTED_EMBED_MODEL=

# --- Embeddings, optional dedicated endpoint ---------------------------------
# Leave empty to reuse the chat provider. Set these when your chat provider has
# no embedding models — notably Ollama Cloud, which serves chat models only.
# EMBED_BASE_URL=https://api.openai.com/v1
# EMBED_API_KEY=sk-...
# EMBED_MODEL_NAME=text-embedding-3-small
# EMBED_DIM must match whatever EMBED_MODEL_NAME returns (768 nomic-embed-text,
# 1536 text-embedding-3-small). It is baked into the pgvector column, so
# changing it on a database that already has chunks needs a re-ingest.
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL_NAME=
EMBED_DIM=768

# --- Observability (Langfuse cloud or self-hosted; empty = tracing disabled) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Database (docker-compose default below; backend falls back to SQLite) ---
# Hosted/serverless deployments need a real Postgres (SQLite cannot persist
# there). pgvector must be available — Neon and Supabase both ship it.
DATABASE_URL=postgresql+psycopg://oep:oep@localhost:5432/oep

# --- Speech (optional; browser Web Speech is the default, no keys needed) ---
STT_PROVIDER=none
TTS_PROVIDER=none

# --- CORS ---
FRONTEND_URL=http://localhost:3000

# --- Uploads ----------------------------------------------------------------
# Empty = "uploads" locally and "/tmp/uploads" on serverless hosts, where the
# rest of the filesystem is read-only. Empty is almost always what you want.
UPLOAD_DIR=
# Empty = auto: 50 MB locally, 4 MB on serverless (Vercel rejects bodies > 4.5 MB).
MAX_UPLOAD_MB=
